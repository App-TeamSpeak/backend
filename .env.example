# URLs públicas utilizadas por el navegador durante el build de Docker.
VITE_API_URL=http://localhost:10000
VITE_REALTIME_URL=http://localhost:10001
# Orígenes permitidos por la API; sin barra final.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
NODE_ENV=development

# Firebase Web App configuration passed to the frontend build only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
